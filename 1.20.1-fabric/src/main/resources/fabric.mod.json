{
  "schemaVersion": 1,
  "id": "itamiotogglesneak",
  "version": "${version}",
  "name": "Toggle Sneak — Itamio Port",
  "description": "Client-side toggle sneak: tap the sneak key to stay crouched, tap again to stand up. Independent implementation for versions without a native toggle-sneak feature.",
  "authors": [
    "Sekai0NI0itamio"
  ],
  "contact": {
    "homepage": "https://github.com/Mobilelize/Revert-Toggle-Sneak",
    "sources": "https://github.com/Mobilelize/Revert-Toggle-Sneak"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "itamio.iamtogglesneak.ToggleSneakClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
